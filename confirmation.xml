<t t-name="website_sale.confirmation">
        <!--
            FIX (mismo patrón que el resto del flujo de compra):
            se envuelve en ".isekai-cart-page" porque esta vista también
            usa "website_sale.checkout_layout" y es el último paso
            (carrito -> dirección -> checkout -> pago -> ESTA PÁGINA),
            así que hereda sin trabajo extra los TOKENS de tema, el
            fondo de página y el header/footer nativos ocultos.
        -->
        <div class="isekai-cart-page">

            <!-- =================================================
                 HEADER ISEKAI (idéntico al resto del sitio)
                 ================================================= -->
            <header class="isekai-header">
                <div class="isekai-container isekai-header-inner">

                    <!-- LOGO -->
                    <a href="/" class="isekai-logo" aria-label="Isekai TCG Store">
                        <img src="/web/image/1329-73065db4/01_Marca%20completa_fondo%20claro%20%284%29.webp" alt="" data-attachment-id="1328" class="isekai-logo-image img img-fluid o_we_custom_image o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="162" data-original-id="1328" data-original-src="/web/image/1328-48608fe1/01_Marca%20completa_fondo%20claro%20%284%29.png" data-mimetype-before-conversion="image/png" data-mimetype="image/webp"/>
                    </a>

                    <!-- BUSCADOR -->
                    <form action="/shop" method="get" class="isekai-search" role="search">
                        <input type="search" name="search" placeholder="Buscar productos..." autocomplete="off" aria-label="Buscar productos"/>
                        <button type="submit" aria-label="Buscar" title="Buscar">
                            <span class="fa fa-search"/>
                        </button>
                    </form>

                    <!-- MODO CLARO / OSCURO -->
                    <button type="button" class="isekai-theme-toggle" aria-label="Cambiar a modo claro" aria-pressed="false" title="Cambiar a modo claro">
                        <i class="fa fa-moon-o isekai-theme-icon-dark" aria-hidden="true"/>
                        <i class="fa fa-sun-o isekai-theme-icon-light" aria-hidden="true"/>
                    </button>

                    <!-- CARRITO -->
                    <a href="/shop/cart" class="isekai-cart-link" aria-label="Ver carrito" title="Ver carrito">
                        <i class="fa fa-shopping-cart" aria-hidden="true"/>
                        <sup class="my_cart_quantity isekai-cart-badge" t-esc="website_sale_cart_quantity" t-att-style="'display:none;' if not website_sale_cart_quantity else None"/>
                    </a>

                    <!-- USUARIO -->
                    <div class="isekai-user">
                        <t t-if="request.env.user._is_public()">
                            <div class="isekai-user-dropdown">
                                <button type="button" class="isekai-user-button" aria-expanded="false" aria-label="Abrir menú de usuario">
                                    <i class="fa fa-user" aria-hidden="true"/>
                                    <span>Mi cuenta</span>
                                    <i class="fa fa-chevron-down isekai-user-arrow" aria-hidden="true"/>
                                </button>
                                <div class="isekai-user-menu">
                                    <div class="isekai-user-menu-header">
                                        <i class="fa fa-user-circle" aria-hidden="true"/>
                                        <div>
                                            <strong>Bienvenido</strong>
                                            <small>Accede a tu cuenta</small>
                                        </div>
                                    </div>
                                    <div class="isekai-user-menu-links">
                                        <a href="/web/login?redirect=/">
                                            <i class="fa fa-sign-in" aria-hidden="true"/>
                                            <span>Iniciar sesión</span>
                                        </a>
                                        <a href="/web/signup?redirect=/">
                                            <i class="fa fa-user-plus" aria-hidden="true"/>
                                            <span>Crear cuenta</span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="isekai-user-dropdown">
                                <button type="button" class="isekai-user-button" aria-expanded="false" aria-label="Abrir menú de usuario">
                                    <i class="fa fa-user" aria-hidden="true"/>
                                    <span t-out="request.env.user.name"/>
                                    <i class="fa fa-chevron-down isekai-user-arrow" aria-hidden="true"/>
                                </button>
                                <div class="isekai-user-menu">
                                    <div class="isekai-user-menu-header">
                                        <i class="fa fa-user-circle" aria-hidden="true"/>
                                        <div>
                                            <strong>Mi cuenta</strong>
                                            <small t-out="request.env.user.email"/>
                                        </div>
                                    </div>
                                    <div class="isekai-user-menu-links">
                                        <a href="/my/home">
                                            <i class="fa fa-user" aria-hidden="true"/>
                                            <span>Mi perfil</span>
                                        </a>
                                        <a href="/my/orders">
                                            <i class="fa fa-shopping-bag" aria-hidden="true"/>
                                            <span>Mis pedidos</span>
                                        </a>
                                        <a href="/web/session/logout?redirect=/" class="isekai-logout">
                                            <i class="fa fa-sign-out" aria-hidden="true"/>
                                            <span>Cerrar sesión</span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </header>

            <t t-set="oe_structure">
                <!-- This is the drag-and-drop area for website building blocs at the end of each
                     checkout page. This is append at the of the page in `checkout_layout`. The
                     templates created in the database to store blocs are hooked using XPath on the
                     `oe_struture` element ID. Therefore, we can't use dynamic IDs (like with
                     t-att-id) and each template needs to define a div element. -->
                <div class="oe_structure" id="oe_structure_website_sale_confirmation_3"/>
            </t>
            <t t-call="website_sale.checkout_layout" show_wizard_checkout="False" show_mobile_cart_summary="False" show_navigation_button="False" show_footer="True" additional_title.translate="Tienda - Confirmado" hide_promotions="True" oe_structure="oe_structure">

                <t t-set="tx_sudo" t-value="order.get_portal_last_transaction()"/>
                <div t-if="tx_sudo.state in ['pending', 'done'] or not order.amount_total" class="d-flex justify-content-between align-items-center">
                    <h3>Gracias por su pedido.</h3>
                    <div t-if="not order.invoice_count">
                        <a title="Download" role="button" class="d-none d-md-inline-block btn btn-light ms-auto" href="/shop/print" target="_blank" aria-label="Download">
                            <i class="fa fa-download me-2"/>Download
                        </a>
                    </div>
                    <div t-else="">
                        <div class="dropdown d-none d-md-inline-block ms-auto">
                            <button class="btn btn-light dropdown-toggle" type="button" id="downloadDropdown" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Download">
                                <i class="fa fa-download me-2"/>Download
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="downloadDropdown">
                                <li>
                                    <a class="dropdown-item" href="/shop/print" target="_blank" title="Download Sale Order" aria-label="Download Sale Order">
                                        <i class="fa fa-cart-arrow-down me-2"/>Order
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="/shop/print/invoice" target="_blank" title="Download Invoice" aria-label="Download Invoice">
                                        <i class="fa fa-file-text-o me-2"/>Invoice
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div id="order_name" class="mb-4">
                    <h5>
                        <span>Pedido</span>
                        <span t-field="order.name"/>
                    </h5>
                </div>
                <t t-if="signup_url">
                    <p class="alert alert-info mt-3" role="status">
                        <a role="button" t-att-href="signup_url" class="btn btn-primary o_translate_inline">Registrarse</a>
                        <span class="align-middle">para hacer seguimiento de tu pedido.</span>
                    </p>
                </t>
                <div class="oe_structure clearfix mt-3" id="oe_structure_website_sale_confirmation_1"/>
                <t t-call="website_sale.payment_confirmation_status"/>
                <div class="mt-3">
                    <t t-call="website_sale.address_on_checkout"/>
                </div>
                <div class="oe_structure mt-3" id="oe_structure_website_sale_confirmation_2"/>
                <input t-if="website.plausible_shared_key" type="hidden" class="js_plausible_push" data-event-name="Shop" t-attf-data-event-params="{&quot;CTA&quot;: &quot;Order Confirmed&quot;, &quot;amount&quot;: &quot;#{&quot;%3s-%3s&quot; % (max(0, round(website_sale_order.amount_total/100)*100 - 50), round(website_sale_order.amount_total/100)*100 + 50)}&quot;}"/>
                <div class="d-lg-none">
                    <t t-call="website_sale.cart_summary_content"/>
                    <t t-call="website_sale.total" _cart_total_classes.f="border-top pt-2"/>
                </div>
            </t>
        </div>
    </t>