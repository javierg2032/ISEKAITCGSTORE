<t name="Contact Details" t-name="portal.portal_my_details">
    <t t-set="no_footer" t-value="1"/>
    <!-- AUTOR: se define antes del t-call para que exista al pintar <head> -->
    <t t-set="head">
        <meta name="author" content="Javier Galán Cortés - https://github.com/javierg2032"/>
    </t>
    <t t-call="portal.portal_layout" additional_title.translate="Contact Details" no_breadcrumbs="1">

        <!-- =====================================================
             DETALLES DEL CONTACTO (PORTAL, /my/account)
             =====================================================
             Destino de la tarjeta "Editar información" de /my/home.
             Mismo patrón que el resto del portal (security.xml,
             orders.xml...): se mantiene t-call="portal.portal_layout"
             y solo se viste con la cabecera, nav y footer de Isekai.
             El formulario (div.o_customer_address_fill y su <form>)
             se deja tal cual lo trae Odoo: account y account_peppol
             lo amplían con vistas heredadas (envío de facturas,
             formato electrónico) que dependen de esa estructura.
             Estilos: sección "PORTAL · Detalles del contacto" de
             style.css (.isekai-account-form).
             ===================================================== -->
        <div class="isekai-portal-page">

            <!-- =================================================
                 HEADER ISEKAI (idéntico al resto del sitio)
                 ================================================= -->
            <header class="isekai-header">
                <div class="isekai-container isekai-header-inner">

                    <!-- LOGO -->
                    <a href="/" class="isekai-logo" aria-label="Isekai TCG Store">
                        <img src="/web/image/1329-73065db4/01_Marca%20completa_fondo%20claro%20%284%29.webp" alt="" data-attachment-id="1328" class="isekai-logo-image img img-fluid o_we_custom_image o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="162" data-original-id="1328" data-original-src="/web/image/1328-48608fe1/01_Marca%20completa_fondo%20claro%20%284%29.png" data-mimetype-before-conversion="image/png" data-mimetype="image/webp"/>
                    </a>

                    <!-- BUSCADOR -->
                    <form action="/shop" method="get" class="isekai-search" role="search">
                        <input type="search" name="search" placeholder="Buscar productos..." autocomplete="off" aria-label="Buscar productos"/>
                        <button type="submit" aria-label="Buscar" title="Buscar">
                            <span class="fa fa-search"/>
                        </button>
                    </form>

                    <!-- MODO CLARO / OSCURO -->
                    <button type="button" class="isekai-theme-toggle" aria-label="Cambiar a modo claro" aria-pressed="false" title="Cambiar a modo claro">
                        <i class="fa fa-moon-o isekai-theme-icon-dark" aria-hidden="true"/>
                        <i class="fa fa-sun-o isekai-theme-icon-light" aria-hidden="true"/>
                    </button>

                    <!-- CARRITO -->
                    <a href="/shop/cart" class="isekai-cart-link" aria-label="Ver carrito" title="Ver carrito">
                        <i class="fa fa-shopping-cart" aria-hidden="true"/>
                        <sup class="my_cart_quantity isekai-cart-badge" t-esc="website_sale_cart_quantity" t-att-style="'display:none;' if not website_sale_cart_quantity else None"/>
                    </a>

                    <!-- USUARIO -->
                    <div class="isekai-user">
                        <t t-if="request.env.user._is_public()">
                            <div class="isekai-user-dropdown">
                                <button type="button" class="isekai-user-button" aria-expanded="false" aria-label="Abrir menú de usuario">
                                    <i class="fa fa-user" aria-hidden="true"/>
                                    <span>Mi cuenta</span>
                                    <i class="fa fa-chevron-down isekai-user-arrow" aria-hidden="true"/>
                                </button>
                                <div class="isekai-user-menu">
                                    <div class="isekai-user-menu-header">
                                        <i class="fa fa-user-circle" aria-hidden="true"/>
                                        <div>
                                            <strong>Bienvenido</strong>
                                            <small>Accede a tu cuenta</small>
                                        </div>
                                    </div>
                                    <div class="isekai-user-menu-links">
                                        <a href="/web/login?redirect=/my/security">
                                            <i class="fa fa-sign-in" aria-hidden="true"/>
                                            <span>Iniciar sesión</span>
                                        </a>
                                        <a href="/web/signup?redirect=/my/security">
                                            <i class="fa fa-user-plus" aria-hidden="true"/>
                                            <span>Crear cuenta</span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="isekai-user-dropdown">
                                <button type="button" class="isekai-user-button" aria-expanded="false" aria-label="Abrir menú de usuario">
                                    <i class="fa fa-user" aria-hidden="true"/>
                                    <span t-out="request.env.user.name"/>
                                    <i class="fa fa-chevron-down isekai-user-arrow" aria-hidden="true"/>
                                </button>
                                <div class="isekai-user-menu">
                                    <div class="isekai-user-menu-header">
                                        <i class="fa fa-user-circle" aria-hidden="true"/>
                                        <div>
                                            <strong>Mi cuenta</strong>
                                            <small t-out="request.env.user.email"/>
                                        </div>
                                    </div>
                                    <div class="isekai-user-menu-links">
                                        <a href="/my/home">
                                            <i class="fa fa-user" aria-hidden="true"/>
                                            <span>Mi perfil</span>
                                        </a>
                                        <a href="/my/orders">
                                            <i class="fa fa-shopping-bag" aria-hidden="true"/>
                                            <span>Mis pedidos</span>
                                        </a>
                                        <a href="/shop/wishlist">
                                            <i class="fa fa-heart" aria-hidden="true"/>
                                            <span>Mi lista de deseos</span>
                                        </a>
                                        <a href="/web/session/logout?redirect=/" class="isekai-logout">
                                            <i class="fa fa-sign-out" aria-hidden="true"/>
                                            <span>Cerrar sesión</span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </header>

            <!-- =================================================
                 CATEGORÍAS (idéntico patrón que el resto del sitio)
                 ================================================= -->
            <nav class="isekai-category-nav" aria-label="Categorías de productos">
                <div class="isekai-container">
                    <div class="isekai-category-list">
                        <t t-foreach="request.env['product.public.category'].sudo().search([('parent_id', '=', False)], order='sequence, name')" t-as="category_nav">
                            <div class="isekai-category-dropdown">
                                <a t-att-href="'/shop/category/%s' % category_nav.id" class="isekai-category-button" t-att-data-category-id="category_nav.id" t-att-aria-expanded="'false' if category_nav.child_id else None">
                                    <span><t t-out="category_nav.name"/></span>
                                    <i t-if="category_nav.child_id" class="fa fa-chevron-down isekai-category-arrow" aria-hidden="true"/>
                                </a>
                                <div t-if="category_nav.child_id" class="isekai-subcategory-menu" role="menu">
                                    <t t-foreach="category_nav.child_id.sorted(key=lambda c: (c.sequence, c.name))" t-as="subcategory_nav">
                                        <a t-att-href="'/gradea-con-nosotros' if (subcategory_nav.name or '').strip().lower() == 'gradea con nosotros' else '/shop/category/%s' % subcategory_nav.id" class="isekai-subcategory-link" role="menuitem">
                                            <t t-out="subcategory_nav.name"/>
                                        </a>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </nav>

            <!-- =================================================
                 CONTENIDO: DETALLES DEL CONTACTO
                 ================================================= -->
            <div class="isekai-container isekai-portal-content">

                <!-- CABECERA DE PÁGINA: mismo patrón "eyebrow +
                     título" que /my/home. -->
                <div class="isekai-portal-heading">
                    <a href="/my/home" class="isekai-account-back"><i class="oi oi-chevron-left" aria-hidden="true"/> Mi cuenta</a>
                    <span class="isekai-shop-eyebrow">MI CUENTA</span>
                    <h1 class="isekai-shop-title">Editar información</h1>
                    <p class="isekai-portal-subtitle">
                        Actualiza tu nombre, datos de contacto, dirección y foto de perfil.
                    </p>
                </div>

                <div class="o_customer_address_fill isekai-account-form">
                    <div class="row">
                        <div name="address_div" class="oe_clear_stucture col-12">
                            <div>
                                <div id="errors"/> <!-- for js -->
                                <form action="/my/address/submit" method="post" name="address_form" class="address_autoformat" t-att-data-company-country-code="res_company.country_id.code" t-att-data-submit-url="'/my/address/submit'">
                                    <div name="form_details" class="row d-flex flex-column-reverse flex-md-row">
                                        <div class="col-md-9">
                                            <div name="address_details" class="row">
                                                <t t-call="portal.address_form_fields"/>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <t t-call="portal.profile_picture_card"/>
                                        </div>
                                    </div>
                                    <div class="col-md-9">
                                        <t t-call="portal.address_footer"/>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- =================================================
                 FOOTER ISEKAI (idéntico al resto del sitio)
                 ================================================= -->
            <footer class="isekai-footer">

                <!-- NEWSLETTER -->
                <div class="isekai-footer-newsletter">
                    <div class="isekai-container">
                        <div class="isekai-newsletter-content">
                            <div class="isekai-newsletter-text">
                                <span class="isekai-footer-eyebrow">MANTENTE AL DÍA</span>
                                <h2>Recibe las últimas ofertas y novedades</h2>
                                <p>Suscríbete para conocer nuestras novedades, nuevos productos, promociones y eventos.</p>
                            </div>
                            <form class="isekai-newsletter-form" action="/website_mass_mailing/subscribe" method="post">
                                <input type="email" name="email" placeholder="Su dirección de email" aria-label="Su dirección de email" required="required"/>
                                <button type="submit" aria-label="Suscribirse al boletín">
                                    Enviar
                                    <i class="fa fa-arrow-right" aria-hidden="true"/>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- FOOTER PRINCIPAL -->
                <div class="isekai-container">
                    <div class="isekai-footer-main">

                        <!-- MARCA -->
                        <div class="isekai-footer-section isekai-footer-brand">
                            <div class="isekai-footer-logo">ISEKAI</div>
                            <strong>ISEKAI TCG STORE</strong>
                            <p>Tu tienda especializada en TCG, Warhammer, Funko POP, figuras anime y coleccionismo.</p>
                            <p class="isekai-footer-location">
                                <i class="fa fa-map-marker" aria-hidden="true"/>
                                Alcorcón, Madrid
                            </p>
                        </div>

                        <!-- TIENDA -->
                        <div class="isekai-footer-section">
                            <h3>Tienda</h3>
                            <a href="/shop"><i class="fa fa-angle-right" aria-hidden="true"/>Tienda</a>
                            <a href="/shop"><i class="fa fa-angle-right" aria-hidden="true"/>Categorías</a>
                            <a href="/shop"><i class="fa fa-angle-right" aria-hidden="true"/>Novedades</a>
                        </div>

                        <!-- MI CUENTA -->
                        <div class="isekai-footer-section">
                            <h3>Mi cuenta</h3>
                            <a href="/my/home"><i class="fa fa-angle-right" aria-hidden="true"/>Mi perfil</a>
                            <a href="/my/orders"><i class="fa fa-angle-right" aria-hidden="true"/>Mis pedidos</a>
                            <a href="/shop/cart"><i class="fa fa-angle-right" aria-hidden="true"/>Mi carrito</a>
                        </div>

                        <!-- CONTACTO -->
                        <div class="isekai-footer-section">
                            <h3>Contacto</h3>
                            <a href="tel:+34604949849"><i class="fa fa-phone" aria-hidden="true"/>604 94 98 49</a>
                            <a href="mailto:isekaigeekshop@gmail.com"><i class="fa fa-envelope" aria-hidden="true"/>isekaigeekshop@gmail.com</a>
                            <div class="isekai-footer-address">
                                <i class="fa fa-map-marker" aria-hidden="true"/>
                                <span>Avenida Torres Bellas, 4<br/>28923 Alcorcón, Madrid<br/>España</span>
                            </div>
                        </div>
                    </div>

                    <!-- COMUNIDAD -->
                    <div class="isekai-footer-community">
                        <div class="isekai-footer-community-column">
                            <h3>Nuestras redes</h3>
                            <div class="isekai-footer-social">
                                <a href="https://twitter.com/ISEKAI_ALCORCON" target="_blank" rel="noopener noreferrer" aria-label="Twitter" title="Twitter">
                                    <i class="fa fa-twitter" aria-hidden="true"/>
                                    <span>Twitter</span>
                                </a>
                                <a href="https://www.instagram.com/isekai.alcorcon/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" title="Instagram">
                                    <i class="fa fa-instagram" aria-hidden="true"/>
                                    <span>Instagram</span>
                                </a>
                            </div>
                        </div>
                        <div class="isekai-footer-community-column isekai-footer-groups">
                            <h3>Únete a nuestra comunidad</h3>
                            <div class="isekai-footer-group-list">
                                <a href="https://chat.whatsapp.com/GBbaAx0tZjFEjawZ8uiMHC" target="_blank" rel="noopener noreferrer">Magic The Gathering</a>
                                <a href="https://chat.whatsapp.com/JxQ0IJIg8wsEmYJiQoa9Ml" target="_blank" rel="noopener noreferrer">One Piece Card Game</a>
                                <a href="https://chat.whatsapp.com/C2yBWYtLRwKCR5JVDMZpTu" target="_blank" rel="noopener noreferrer">Riftbound</a>
                                <a href="https://chat.whatsapp.com/CvMDq95DQSa0gwmoe4nJol" target="_blank" rel="noopener noreferrer">Digimon Card Game</a>
                                <a href="https://chat.whatsapp.com/HwX9OjW7Ma59A19VDfsPyJ" target="_blank" rel="noopener noreferrer">Pokémon TCG</a>
                                <a href="https://chat.whatsapp.com/JDiAqNLEF5I3yUprRnLLxF" target="_blank" rel="noopener noreferrer">Gundam</a>
                            </div>
                        </div>
                    </div>

                    <!-- INFORMACIÓN LEGAL -->
                    <div class="isekai-footer-legal">
                        <div class="isekai-footer-legal-title">Condiciones</div>
                        <div class="isekai-footer-legal-links">
                            <a href="/es/cms/condiciones-generales">Condiciones generales</a>
                            <a href="/es/cms/aviso-legal">Aviso legal</a>
                            <a href="/es/cms/politica-de-privacidad">Política de privacidad</a>
                            <a href="/es/cms/politica-cookies">Política de cookies</a>
                            <a href="/es/cms/entrega-y-transporte">Política de envíos</a>
                            <a href="/es/cms/formas-de-pago">Formas de pago</a>
                            <a href="/es/cms/devolucion-y-reembolso">Devolución y reembolso</a>
                        </div>
                    </div>

                    <!-- FOOTER INFERIOR -->
                    <div class="isekai-footer-bottom">
                        <div class="isekai-footer-copyright">© 2026 Isekai TCG Store</div>
                        <div class="isekai-footer-tax">Todos los precios incluyen IVA</div>
                    </div>
                </div>
            </footer>

        </div>
    </t>
</t>