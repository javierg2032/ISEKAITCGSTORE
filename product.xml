<t name="Product" t-name="website_sale.product">
        <!-- Qweb variable defining the class suffix for navbar items.
             Change accordingly to the derired visual result (eg. `primary`, `dark`...)-->
        <t t-set="navClass" t-valuef="light"/>

        <t t-set="is_fullwidth_content" t-value="website.product_page_image_width in ['none', '100_pc']"/>
        <t t-set="is_50_pc" t-value="website.product_page_image_width == '50_pc'"/>

        <t t-call="website.layout" additional_title="product.name">
            <!-- =====================================================
                 FICHA DE PRODUCTO
                 FIX: se añade la clase "isekai-product-page" a #wrap
                 (los estilos de la ficha cuelgan de ella) y dentro de
                 #wrap van el header, el nav de categorías y el footer
                 de Isekai, igual que en el resto de páginas.
                 ===================================================== -->
            <div id="wrap" class="o_wsale_product_page isekai-product-page" t-att-data-has-available-uoms="has_available_uoms">

                <!-- =================================================
                     HEADER
                     ================================================= -->
                <header class="isekai-header">
                    <div class="isekai-container isekai-header-inner">

                        <!-- LOGO -->
                        <a href="/" class="isekai-logo" aria-label="Isekai TCG Store">
                            <img src="/web/image/1329-73065db4/01_Marca%20completa_fondo%20claro%20%284%29.webp" alt="" data-attachment-id="1328" class="isekai-logo-image img img-fluid o_we_custom_image o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="162" data-original-id="1328" data-original-src="/web/image/1328-48608fe1/01_Marca%20completa_fondo%20claro%20%284%29.png" data-mimetype-before-conversion="image/png" data-mimetype="image/webp"/>
                        </a>

                        <!-- BUSCADOR -->
                        <form action="/shop" method="get" class="isekai-search" role="search">
                            <input type="search" name="search" placeholder="Buscar productos..." autocomplete="off" aria-label="Buscar productos"/>
                            <button type="submit" aria-label="Buscar" title="Buscar">
                                <span class="fa fa-search"/>
                            </button>
                        </form>

                        <!-- MODO CLARO / OSCURO -->
                        <button type="button" class="isekai-theme-toggle" aria-label="Cambiar a modo claro" aria-pressed="false" title="Cambiar a modo claro">
                            <i class="fa fa-moon-o isekai-theme-icon-dark" aria-hidden="true"/>
                            <i class="fa fa-sun-o isekai-theme-icon-light" aria-hidden="true"/>
                        </button>

                        <!-- USUARIO -->
                        <div class="isekai-user">

                            <!-- USUARIO NO CONECTADO -->
                            <t t-if="request.env.user._is_public()">
                                <div class="isekai-user-dropdown">
                                    <button type="button" class="isekai-user-button" aria-expanded="false" aria-label="Abrir menú de usuario">
                                        <i class="fa fa-user" aria-hidden="true"/>
                                        <span>Mi cuenta</span>
                                        <i class="fa fa-chevron-down isekai-user-arrow" aria-hidden="true"/>
                                    </button>
                                    <div class="isekai-user-menu">
                                        <div class="isekai-user-menu-header">
                                            <i class="fa fa-user-circle" aria-hidden="true"/>
                                            <div>
                                                <strong>Bienvenido</strong>
                                                <small>Accede a tu cuenta</small>
                                            </div>
                                        </div>
                                        <div class="isekai-user-menu-links">
                                            <a href="/web/login?redirect=/">
                                                <i class="fa fa-sign-in" aria-hidden="true"/>
                                                <span>Iniciar sesión</span>
                                            </a>
                                            <a href="/web/signup?redirect=/">
                                                <i class="fa fa-user-plus" aria-hidden="true"/>
                                                <span>Crear cuenta</span>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </t>

                            <!-- USUARIO CONECTADO -->
                            <t t-else="">
                                <div class="isekai-user-dropdown">
                                    <button type="button" class="isekai-user-button" aria-expanded="false" aria-label="Abrir menú de usuario">
                                        <i class="fa fa-user" aria-hidden="true"/>
                                        <span t-out="request.env.user.name"/>
                                        <i class="fa fa-chevron-down isekai-user-arrow" aria-hidden="true"/>
                                    </button>
                                    <div class="isekai-user-menu">
                                        <div class="isekai-user-menu-header">
                                            <i class="fa fa-user-circle" aria-hidden="true"/>
                                            <div>
                                                <strong>Mi cuenta</strong>
                                                <small t-out="request.env.user.email"/>
                                            </div>
                                        </div>
                                        <div class="isekai-user-menu-links">
                                            <a href="/my/home">
                                                <i class="fa fa-user" aria-hidden="true"/>
                                                <span>Mi perfil</span>
                                            </a>
                                            <a href="/my/orders">
                                                <i class="fa fa-shopping-bag" aria-hidden="true"/>
                                                <span>Mis pedidos</span>
                                            </a>
                                            <a href="/shop/cart">
                                                <i class="fa fa-shopping-cart" aria-hidden="true"/>
                                                <span>Mi carrito</span>
                                            </a>
                                            <a href="/web/session/logout?redirect=/" class="isekai-logout">
                                                <i class="fa fa-sign-out" aria-hidden="true"/>
                                                <span>Cerrar sesión</span>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </t>

                        </div>
                    </div>
                </header>

                <!-- =================================================
                     CATEGORÍAS AUTOMÁTICAS
                     ================================================= -->
                <nav class="isekai-category-nav" aria-label="Categorías de productos">
                    <div class="isekai-container">
                        <div class="isekai-category-list">
                            <t t-foreach="request.env['product.public.category'].sudo().search([('parent_id', '=', False)], order='sequence, name')" t-as="category_nav">
                                <div class="isekai-category-dropdown">
                                    <a t-att-href="'/shop/category/%s' % category_nav.id" class="isekai-category-button" t-att-data-category-id="category_nav.id" t-att-aria-expanded="'false' if category_nav.child_id else None">
                                        <span><t t-out="category_nav.name"/></span>
                                        <i t-if="category_nav.child_id" class="fa fa-chevron-down isekai-category-arrow" aria-hidden="true"/>
                                    </a>
                                    <div t-if="category_nav.child_id" class="isekai-subcategory-menu" role="menu">
                                        <t t-foreach="category_nav.child_id.sorted(key=lambda c: (c.sequence, c.name))" t-as="subcategory">
                                            <a t-att-href="'/shop/category/%s' % subcategory.id" class="isekai-subcategory-link" role="menuitem">
                                                <t t-out="subcategory.name"/>
                                            </a>
                                        </t>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </nav>

                <!-- =================================================
                     CONTENIDO ORIGINAL DE LA FICHA DE PRODUCTO
                     ================================================= -->
                <div class="oe_structure oe_empty oe_structure_not_nearest" id="oe_structure_website_sale_product_1" data-editor-message.translate="Drag blocks here to add them on all products"/>
                <section id="product_detail" t-attf-class="oe_website_sale mt-1 mt-lg-2 mb-5 #{'discount'                             if combination_info['has_discounted_price'] else ''}                             {{website._get_product_page_container() == 'regular' and 'o_wsale_container_lg container-lg' or (website._get_product_page_container() == 'fluid' and 'o_wsale_container_fluid container-fluid' or false)}}                             o_wsale_product_page_opt_image_width_{{website.product_page_image_width}}                             o_wsale_product_page_opt_image_ratio_{{website.product_page_image_ratio}}                             o_wsale_product_page_opt_image_ratio_mobile_{{website.product_page_image_ratio_mobile}}                             o_wsale_product_page_opt_image_radius_{{website.product_page_image_roundness}}                          " t-att-data-view-track="view_track and '1' or '0'">
                    <div class="o_wsale_content_contained container d-flex flex-wrap align-items-center py-3">
                        <div class="d-flex align-items-center flex-grow-1">
                            <ol class="o_wsale_breadcrumb breadcrumb m-0 p-0">
                                <li class="breadcrumb-item d-none d-lg-inline-block">
                                    <a t-att-href="keep(shop_path)">
                                        <t t-call="website_sale.all_products_link_name"/>
                                    </a>
                                </li>
                                <t t-foreach="category.parents_and_self" t-as="cat">
                                    <li class="breadcrumb-item d-none d-lg-inline-block">
                                        <a class="py-2 py-lg-0" t-att-href="keep(cat.website_url)">
                                            <i class="oi oi-chevron-left d-lg-none me-1" role="img"/>
                                            <t t-out="cat.name"/>
                                        </a>
                                    </li>
                                </t>
                                <li class="breadcrumb-item d-none d-lg-inline-block active">
                                    <span t-field="product.name"/>
                                </li>
                                <li class="breadcrumb-item d-lg-none">
                                    <a t-att-href="keep(category.website_url or shop_path)">
                                        <i class="oi oi-chevron-left me-2" role="img"/>
                                        <t t-if="category.name" t-out="category.name"/>
                                        <t t-else="" t-call="website_sale.all_products_link_name"/>
                                    </a>
                                </li>
                            </ol>
                            <div class="d-flex d-md-none gap-2 ms-auto">
                                <t t-call="website_sale.pricelist_list"/>
                                <t t-call="website.website_search_box_input" search_type.f="products" placeholder="placeholder" _simple_button_layout="True" _simple_button_classes.f="o_wsale_product_search_mobile_btn d-none btn-{{navClass}}"/>
                            </div>
                        </div>
                        <div class="o_wsale_product_top_bar_desktop d-none d-md-inline-flex flex-wrap gap-2 w-auto mb-lg-auto">
                            <t t-call="website_sale.pricelist_list"/>
                        </div>
                    </div>
                    <div t-attf-class="row align-items-lg-start {{website.product_page_cols_order == 'inverse' and 'flex-lg-row-reverse' or ''}}" id="product_detail_main" data-name="Product Page" t-att-data-image-layout="website.product_page_image_layout">
                        <div t-attf-class="o_wsale_product_images col o_wsale_sticky_object" t-att-data-image-amount="len(product_variant._get_images() if product_variant else product._get_images())">
                            <t t-call="website_sale.shop_product_images"/>
                        </div>
                        <div id="product_details" t-attf-class="position-relative position-lg-sticky o_wsale_sticky_object col">
                            <div id="o_wsale_product_details_content" t-attf-class="js_product o_wsale_content_contained container">
                                <!-- Product title (purchase not available)-->
                                <t t-set="is_add_to_cart_possible" t-value="product._is_add_to_cart_possible()"/>
                                <t t-if="not is_add_to_cart_possible" t-call="website_sale.product_title"/>

                                <article t-if="is_add_to_cart_possible">
                                    <!-- Product title (purchase available)-->
                                    <t t-call="website_sale.product_title"/>

                                    <div t-if="not is_view_active('website_sale.cta_wrapper_boxed')" class="o_wsale_product_details_content_section o_wsale_product_details_content_section_price mb-4">
                                        <t t-call="website_sale.product_price"/>
                                        <t t-if="'base_unit_price' in combination_info" t-call="website_sale.base_unit_price" base_unit_price="combination_info['base_unit_price']"/>
                                    </div>

                                    <t name="variant_info">
                                        <div t-attf-class="o_wsale_product_details_content_section o_wsale_product_details_content_section_attributes mb-4 {{not (product.valid_product_template_attribute_line_ids or (product_variant and product_variant._has_multiple_uoms())) and 'd-none' or ''}}">
                                            <t t-call="website_sale.variants" ul_class.f="flex-column" combination="combination_info['combination']"/>
                                        </div>
                                    </t>
                                    <div id="o_wsale_product_cta_section" class="o_wsale_product_details_content_section o_wsale_product_details_content_section_cta mb-4">
                                        <t t-call="website_sale.cta_wrapper"/>
                                    </div>

                                    <div class="o_wsale_product_details_content_section o_wsale_product_details_content_section_accordion mb-4" t-if="is_view_active('website_sale.accordion_specs_item') or is_view_active('website_sale.accordion_more_information')">
                                        <t t-call="website_sale.product_accordion"/>
                                    </div>
                                    <t t-set="product_documents" t-value="product.sudo().product_document_ids.filtered(lambda doc: doc.shown_on_product_page)"/>
                                    <div id="product_documents" class="o_wsale_product_details_content_section o_wsale_product_details_content_section_documents mb-4" t-if="product_documents">
                                        <strong>Documentos</strong>
                                        <div class="list-group">
                                            <t t-foreach="product_documents" t-as="document_sudo">
                                                <t t-set="attachment_sudo" t-value="document_sudo.ir_attachment_id"/>
                                                <t t-set="target" t-value="attachment_sudo.type == 'url' and '_blank' or '_self'"/>
                                                <t t-set="icon" t-value="attachment_sudo.type == 'url' and 'fa-link' or 'fa-download'"/>
                                                <a class="list-group-item list-group-item-action" t-att-href="'/shop/' + slug(product) + '/document/' + str(document_sudo.id)" t-att-target="target">
                                                    <i t-att-class="'fa ' + icon + ' me-2'"/>
                                                    <t t-out="attachment_sudo.name"/>
                                                </a>
                                            </t>
                                        </div>
                                    </div>
                                </article>
                            </div>
                        </div>
                    </div>
                </section>
                <div id="product_full_description" t-field="product.website_description" class="oe_structure oe_empty mt16"/>
                <div class="oe_structure oe_empty oe_structure_not_nearest mt16" id="oe_structure_website_sale_product_2" data-editor-message.translate="Drag blocks here to add them on all products"/>

                <!-- =================================================
                     FOOTER
                     ================================================= -->
                <footer class="isekai-footer">

                    <!-- NEWSLETTER -->
                    <div class="isekai-footer-newsletter">
                        <div class="isekai-container">
                            <div class="isekai-newsletter-content">
                                <div class="isekai-newsletter-text">
                                    <span class="isekai-footer-eyebrow">MANTENTE AL DÍA</span>
                                    <h2>Recibe las últimas ofertas y novedades</h2>
                                    <p>Suscríbete para conocer nuestras novedades, nuevos productos, promociones y eventos.</p>
                                </div>
                                <form class="isekai-newsletter-form" action="/website_mass_mailing/subscribe" method="post">
                                    <input type="email" name="email" placeholder="Su dirección de email" aria-label="Su dirección de email" required="required"/>
                                    <button type="submit" aria-label="Suscribirse al boletín">
                                        Enviar
                                        <i class="fa fa-arrow-right" aria-hidden="true"/>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- CONTENIDO PRINCIPAL FOOTER -->
                    <div class="isekai-container">
                        <div class="isekai-footer-main">

                            <!-- MARCA -->
                            <div class="isekai-footer-section isekai-footer-brand">
                                <div class="isekai-footer-logo">ISEKAI</div>
                                <strong>ISEKAI TCG STORE</strong>
                                <p>Tu tienda especializada en TCG, Warhammer, Funko POP, figuras anime y coleccionismo.</p>
                                <p class="isekai-footer-location">
                                    <i class="fa fa-map-marker" aria-hidden="true"/>
                                    Alcorcón, Madrid
                                </p>
                            </div>

                            <!-- TIENDA -->
                            <div class="isekai-footer-section">
                                <h3>Tienda</h3>
                                <a href="/shop"><i class="fa fa-angle-right" aria-hidden="true"/>Tienda</a>
                                <a href="/shop"><i class="fa fa-angle-right" aria-hidden="true"/>Categorías</a>
                                <!-- FIX: fuera de la home el ancla "#isekai-novedades" no existe; se enlaza a la home. -->
                                <a href="/#isekai-novedades"><i class="fa fa-angle-right" aria-hidden="true"/>Novedades</a>
                            </div>

                            <!-- MI CUENTA -->
                            <div class="isekai-footer-section">
                                <h3>Mi cuenta</h3>
                                <a href="/my/home"><i class="fa fa-angle-right" aria-hidden="true"/>Mi perfil</a>
                                <a href="/my/orders"><i class="fa fa-angle-right" aria-hidden="true"/>Mis pedidos</a>
                                <a href="/shop/cart"><i class="fa fa-angle-right" aria-hidden="true"/>Mi carrito</a>
                            </div>

                            <!-- CONTACTO -->
                            <div class="isekai-footer-section">
                                <h3>Contacto</h3>
                                <a href="tel:+34604949849"><i class="fa fa-phone" aria-hidden="true"/>604 94 98 49</a>
                                <a href="mailto:isekaigeekshop@gmail.com"><i class="fa fa-envelope" aria-hidden="true"/>isekaigeekshop@gmail.com</a>
                                <div class="isekai-footer-address">
                                    <i class="fa fa-map-marker" aria-hidden="true"/>
                                    <span>Avenida Torres Bellas, 4<br/>28923 Alcorcón, Madrid<br/>España</span>
                                </div>
                            </div>
                        </div>

                        <!-- COMUNIDAD -->
                        <div class="isekai-footer-community">
                            <div class="isekai-footer-community-column">
                                <h3>Nuestras redes</h3>
                                <div class="isekai-footer-social">
                                    <a href="https://twitter.com/ISEKAI_ALCORCON" target="_blank" rel="noopener noreferrer" aria-label="Twitter" title="Twitter">
                                        <i class="fa fa-twitter" aria-hidden="true"/>
                                        <span>Twitter</span>
                                    </a>
                                    <a href="https://www.instagram.com/isekai.alcorcon/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" title="Instagram">
                                        <i class="fa fa-instagram" aria-hidden="true"/>
                                        <span>Instagram</span>
                                    </a>
                                </div>
                            </div>
                            <div class="isekai-footer-community-column isekai-footer-groups">
                                <h3>Únete a nuestra comunidad</h3>
                                <div class="isekai-footer-group-list">
                                    <a href="https://chat.whatsapp.com/GBbaAx0tZjFEjawZ8uiMHC" target="_blank" rel="noopener noreferrer">Magic The Gathering</a>
                                    <a href="https://chat.whatsapp.com/JxQ0IJIg8wsEmYJiQoa9Ml" target="_blank" rel="noopener noreferrer">One Piece Card Game</a>
                                    <a href="https://chat.whatsapp.com/C2yBWYtLRwKCR5JVDMZpTu" target="_blank" rel="noopener noreferrer">Riftbound</a>
                                    <a href="https://chat.whatsapp.com/CvMDq95DQSa0gwmoe4nJol" target="_blank" rel="noopener noreferrer">Digimon Card Game</a>
                                    <a href="https://chat.whatsapp.com/HwX9OjW7Ma59A19VDfsPyJ" target="_blank" rel="noopener noreferrer">Pokémon TCG</a>
                                    <a href="https://chat.whatsapp.com/JDiAqNLEF5I3yUprRnLLxF" target="_blank" rel="noopener noreferrer">Gundam</a>
                                </div>
                            </div>
                        </div>

                        <!-- INFORMACIÓN LEGAL -->
                        <div class="isekai-footer-legal">
                            <div class="isekai-footer-legal-title">Condiciones</div>
                            <div class="isekai-footer-legal-links">
                                <a href="/es/cms/condiciones-generales">Condiciones generales</a>
                                <a href="/es/cms/aviso-legal">Aviso legal</a>
                                <a href="/es/cms/politica-de-privacidad">Política de privacidad</a>
                                <a href="/es/cms/politica-cookies">Política de cookies</a>
                                <a href="/es/cms/entrega-y-transporte">Política de envíos</a>
                                <a href="/es/cms/formas-de-pago">Formas de pago</a>
                                <a href="/es/cms/devolucion-y-reembolso">Devolución y reembolso</a>
                            </div>
                        </div>

                        <!-- FOOTER INFERIOR -->
                        <div class="isekai-footer-bottom">
                            <div class="isekai-footer-copyright">© 2026 Isekai TCG Store</div>
                            <div class="isekai-footer-tax">Todos los precios incluyen IVA</div>
                            <div class="isekai-footer-developer">
                                Diseñado y desarrollado por
                                <strong>Javier Galán Cortés</strong>
                            </div>
                        </div>
                    </div>
                </footer>

            </div>
        </t>
    </t>