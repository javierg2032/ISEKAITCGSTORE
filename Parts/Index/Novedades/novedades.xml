<t t-name="website.homepage">
    <t t-call="website.layout">
        <!-- =====================================================
             HOME
             ===================================================== -->
        <div id="isekai-home">

<!-- =================================================
                 NOVEDADES
                 ================================================= -->
            <section class="isekai-section" id="isekai-novedades">
                <div class="isekai-container">
                    <div class="isekai-section-title">
                        <div>
                            <span>DESCUBRE</span>
                            <h2>Últimas novedades</h2>
                        </div>
                        <a href="/shop">
                            Ver todos
                            <i class="fa fa-arrow-right" aria-hidden="true"/>
                        </a>
                    </div>

                    <div class="isekai-products-grid">
                        <!--
                            FIX: se añade ('website_published', '=', True)
                            al dominio. Antes, con sudo() y solo
                            sale_ok=True, un producto en borrador o
                            despublicado podía llegar a mostrarse a
                            visitantes anónimos en la home.
                        -->
                        <t t-foreach="request.env['product.template'].sudo().search([('sale_ok', '=', True), ('website_published', '=', True)], order='create_date desc', limit=20)" t-as="product">
                            <a t-att-href="'/shop/' + str(product.id)" class="isekai-product-card">
                                <div class="isekai-product-image">
                                    <img t-if="product.image_1920" t-att-src="'/web/image/product.template/%s/image_1920' % product.id" t-att-alt="product.name" loading="lazy"/>
                                    <span t-else="">Sin imagen</span>
                                </div>
                                <div class="isekai-product-info">
                                    <div class="isekai-product-name" t-out="product.name"/>
                                    <!--
                                        FIX: precio con el widget monetario
                                        de Odoo en vez de t-out en crudo +
                                        "€" a mano (respeta pricelist,
                                        redondeo y moneda de la web).
                                    -->
                                    <div class="isekai-product-price" t-out="product.list_price" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                                </div>
                            </a>
                        </t>
                    </div>
                </div>
            </section>


                              </div>
        </t></t>